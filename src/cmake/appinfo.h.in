///
/// \file appinfo.h
/// \brief Product identity and build versions, generated by CMake.
///
/// Kept out of the global compile definitions: the dev version carries the commit hash, and
/// a definition on every compile line would rebuild the whole tree after each commit.
///

#pragma once

#define APP_NAME "@PRODUCT_NAME@"
#define APP_ORGANIZATION_NAME "@ORGANIZATION_NAME@"
#define APP_PRODUCT_NAME "@PRODUCT_NAME@"
#define APP_DESCRIPTION "@PROJECT_DESCRIPTION@"
#define APP_VERSION_MAJOR "@VERSION_MAJOR@"
#define APP_VERSION_MINOR "@VERSION_MINOR@"
#define APP_VERSION_PATCH "@VERSION_PATCH@"
#define APP_VERSION "@PROJECT_VERSION@"
#define BUILD_YEAR "@CURRENT_YEAR@"
#define APP_OPENSSL_VERSION "@OPENSSL_VERSION@"
#define APP_QTKEYCHAIN_VERSION "@QTKEYCHAIN_VERSION@"
#define OPCUA_OPEN62541_VERSION "@OPCUA_OPEN62541_VERSION@"
